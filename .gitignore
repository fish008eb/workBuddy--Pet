# 运行时生成的形象帧（由 tools/switch-skin.js 产出，版权不属于本仓库）
assets/frames/*.png
assets/frames/manifest.json
assets/frames/delays.txt
!assets/frames/.gitkeep

# 各形象的本地缓存（含 current.txt / status.txt）
# 逐项忽略而非整目录忽略，才能单独放行随包入库的雪碧图形象
assets/skins/*
# 雪碧图形象只放 manifest.json（图集在 assets/atlas/ 共用），必须入库
!assets/skins/tuantuan/
!assets/skins/tuantuan/**
!assets/skins/keke/
!assets/skins/keke/**
!assets/skins/naigai/
!assets/skins/naigai/**
!assets/skins/hoops/
!assets/skins/hoops/**

# 图集重建时生成的编号预览图（build-naigai-atlas.py --preview），可随时重出
assets/atlas/*-preview*.png

# 运行时数据与日志
panel-data.txt
panel-lines.txt
last-turn.txt
pet-events.txt
pet-events.old.txt
pet-ledger.txt
pet-state.txt
pet-state.txt.tmp
pet-bus.port
pet-summary.txt
pet-history.txt
pet-budget.txt
pet-projects.txt
pet-week.txt
pet-weekly.txt
panel-err.log
build.rsp
*.log
WbPet.exe

# 本地编辑器 / 系统
.workbuddy/
.vscode/
.idea/
.openidea/
Thumbs.db
desktop.ini

# 打包产物
dist/
*.tmp

# ---------------------------------------------------------------------------
# Python 环境与语音工具链
# ---------------------------------------------------------------------------
# 两个 venv 加起来超过 1GB，绝对不能入库：tools/.venv-sound 是 edge-tts，
# tools/.venv-moss 是 MOSS 原声推理（含 torch）。
tools/.venv*/
__pycache__/
*.pyc

# MOSS 声线模型权重（152MB）。
# 模型许可明确写了不得 copy / distribute / reproduce，
# 所以权重只在本机存在，由 tools/moss-voice/fetch-model.py 按需下载。
# 注意：assets/sounds/voice/ 下的 wav 是本项目自己合成的产物，要入库。
tools/moss-voice/model/*.pth
tools/moss-voice/model/*.onnx
tools/moss-voice/model/.cache/

# 上游推理代码由 fetch-model.py 拉取，不入库
tools/moss-voice/moss-tts-service-master/

# 试跑输出与下载的压缩包
tools/moss-voice/out*/
tools/moss-voice/*.zip

# ---------------------------------------------------------------------------
# 调试期间的临时目录（试听页、音色对比、失败备份）
# ---------------------------------------------------------------------------
# 留一份 assets/sounds/voice/ 作为唯一素材来源，其余都是过程产物。
# 这些目录现在统一收在 tools/_archive/ 下，保留可查但不入库。
tools/_archive/
tools/voice-preview/
tools/voice-compare/
tools/voice-v1-p18/
tools/voice-quote-review/
tools/voice-moss-original/
tools/voice-moss-work/
assets/sounds/voice-eng-new/
assets/sounds/voice.bak-*/

# 面板 exe 的历史备份
src/*.bak-*
src/*.exe.bak-*

