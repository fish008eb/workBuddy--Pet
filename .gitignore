# 运行时生成的形象帧（由 tools/switch-skin.js 产出，版权不属于本仓库）
assets/frames/*.png
assets/frames/manifest.json
assets/frames/delays.txt
!assets/frames/.gitkeep

# 各形象的本地缓存（含 current.txt / status.txt）
# 逐项忽略而非整目录忽略，才能单独放行随包入库的雪碧图形象
assets/skins/*
# 雪碧图形象只放 manifest.json（图集在 assets/atlas/ 共用），必须入库
!assets/skins/tuantuan/
!assets/skins/tuantuan/**
!assets/skins/keke/
!assets/skins/keke/**
!assets/skins/naigai/
!assets/skins/naigai/**

# 图集重建时生成的编号预览图（build-naigai-atlas.py --preview），可随时重出
assets/atlas/*-preview*.png

# 运行时数据与日志
panel-data.txt
panel-lines.txt
last-turn.txt
pet-events.txt
pet-events.old.txt
pet-ledger.txt
pet-state.txt
pet-state.txt.tmp
pet-bus.port
pet-summary.txt
pet-history.txt
pet-budget.txt
pet-projects.txt
pet-week.txt
pet-weekly.txt
panel-err.log
build.rsp
*.log
WbPet.exe

# 本地编辑器 / 系统
.workbuddy/
.vscode/
.idea/
.openidea/
Thumbs.db
desktop.ini

# 打包产物
dist/
*.tmp
